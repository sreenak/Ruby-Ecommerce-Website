- content_for :title do
  = @user.name

.row
  .col-md-4.col-lg-3= render 'sidebar'
  .col-md-8.col-lg-9
    = simple_form_for @user, url: account_path do |f|
      .row
        .col-sm-6
          = f.input :name
          = f.input :email
          = f.input :password
          = f.input :password_confirmation

        .col-sm-6
          = f.input :date_of_birth, as: :date, :start_year => Time.now.year,
                    :end_year => 1900,
                    :order => [:month, :day, :year]
          = f.input :gender, collection: User::GENDERS, as: :radio_buttons, wrapper: :horizontal_radio_and_checkboxes
          = f.input :image
          = f.hidden_field :image_cache
          = image_tag @user.image_url(:thumbnail), class: 'img-thumbnail' if @user.image?
      = f.submit 'Update', class: 'btn btn-primary'