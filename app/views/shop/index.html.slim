/  = sort_link @product_search, :price_paisas, "Price in acen & decn "
javascript:
  var max_price = #{@max_price.to_s};

- content_for :title do
  |Shop

h1.page-title.text-center.text-uppercase Shop
.row
  .col-md-3.searchwidth
    = search_form_for @product_search, url: shop_index_path do |f|
      .product-filter
        .product-box
          h4 Sort By:
          ul
            li= sort_link(@product_search, :price_paisas, 'Price')
            li= sort_link(@product_search, :featured, 'Latest Released', featured: :true)
        /.sort-by-product
        /  a href="javascript:void(0)"
        /    span.sort_box Sort By:
        /    |Price: Low - High
        /  span.drop-down-arrow.pull-right
        /    i.fa.fa-angle-down
        /  .sort-by-list.hidden
        /    ul
        /      li
        /        a href=""
        /          |Price: Low - High
        /
        /      li
        /        a href=""
        /          |Price: High - Low
        /.product-box
        /  h4
         /   |Categories
         /   span.clear-filters.pull-right Clear

          /ul.product-categories
           / - Category.all.each do |c|
             / li.checkbox.category-lists
              /  label
                /  = f.check_box :category_id_in, {multiple: true}, c.id, nil
               /   = c.name

        .product-box
          h4 Price (in #{@currency})
          .product-price-flt
            input#price-range.hidden type="slider" value="0;#{@max_price}" name="price"

        .product-box
          h4
            |Size
            span.clear-filters.pull-right Clear
          ul.product-size
            - StandardSize.all.each do |s|
              li.checkbox.size-list
                label
                  = f.check_box :standard_sizes_id_in, {multiple: true}, s.id, nil
                  = s.name

        .product-box
          h4
            |Color
            span.clear-filters.pull-right Clear
          ul.product-categories
            - Color.all.each do |c|
              li.checkbox.category-lists
                label
                  = f.check_box :colors_id_in, {multiple: true}, c.id, nil
                  = c.name

        = f.submit 'Filter', class: 'btn btn-default filterbutton'
        <br>

        /= f.submit 'Filter', class: 'btn btn-default'


  .col-md-9.imagewidth
    - if @products.count > 0
      .products.home-product
        - @products.each_slice(3) do |row|
          .row
            - row.each do |product|
              .col-md-4.col-sm-4
                .product-medium.product-preview.hover-container
                  a href="#{shop_path(product)}"
                    = image_tag product.image_url(:medium)
                  .details
                    h4.text-center
                      = link_to truncate(product.name.camelize, :length => 20), shop_path(product)
                    h4.price.text-center
                      -if @cart.currency=="USD"
                        = '$'+ (product.price.exchange_to(@cart.currency).to_i+1).to_s
                      -else @cart.currency=="INR"
                        = '₹'+ (product.price.exchange_to(@cart.currency).to_i).to_s  
                    action-row.top.clearfix.hover-content
                      .pull-right.col-md-6.product-wishliat.text-center
                        - if !current_or_null_user.liked? product
                          -if !user_signed_in?
                            a.text-center href="#" rel="nofollow" data-toggle="modal" data-target="#login-modal"
                              i.icon.ion-ios-heart-outline
                              |Like
                          -else
                            a.text-center href="#{likes_path(:id => product.id)}" data-method="post" rel="nofollow"
                              i.icon.ion-ios-heart-outline
                              |Like
                        - else
                          a.text-center href="#{like_path(:id => product.id)}" data-method="delete" rel="nofollow"
                            i.icon.ion-ios-heart
                            |Unlike

                      .pull-left.text-center.col-md-6.product-addto
                        a.text-center href="#{cart_add_product_path(:product_id => product.id)}" data-method="post" rel="nofollow"
                          i.icon.ion-ios-cart
                          |Add to cart
                      .col-md-12.product-size.text-center
                        /|S, M, L, XL
                        -if !product.standard_sizes.empty?
                          - product.standard_sizes.each do |s|
                            = standard_size = s.name
                            ="," unless s == product.standard_sizes.last
                         
                   

      = paginate @products
    - else
      p No products found matching your criteria. Please remove filters and try again.


  
 
      


