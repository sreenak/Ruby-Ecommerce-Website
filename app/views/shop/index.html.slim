= search_form_for @product_search, url: shop_index_path do |f|
  = f.label :category_cont, "Category"
  - Category.all.each do |c|
    = f.check_box :category_id_in, {multiple: true}, c.id, nil
    = c.name
  br
  = sort_link @product_search, :price_paisas, "Price in acen & decn "
  


  br
  = f.label :price_paisas_gteq,"Price between"
  = f.search_field :price_paisas_gteq
  = f.label :price_paisas_lteq, "and"
  = f.search_field :price_paisas_lteq

  br
  = f.label :size_cont, "Size Available"
  - StandardSize.all.each do |s|
    = f.check_box :standard_sizes_id_in, {multiple: true}, s.id, nil
    = s.name
  br
  = f.label :color_cont, "Colors Available"
  - Color.all.each do |c|
    = f.check_box :colors_id_in, {multiple: true}, c.id, nil
    = c.name
  br
  = f.submit "Search"
  
  br

- content_for :title do
  |Shop

h1.page-title.text-center.text-uppercase Shop

.products
  - @products.each_slice(4) do |row|
    .row
      - row.each do |product|
        .col-md-3.col-sm-6
          .product-preview.hover-container
            a href="#{shop_path(product)}"
              = image_tag product.image_url(:medium)
            .details
              .action-row.top.clearfix.hover-content
                .pull-left
                  - if !current_or_null_user.liked? product
                    i.icon.ion-ios-heart-outline
                    = link_to 'Like', likes_path(:id => product.id), method: :post
                  - else
                    i.icon.ion-ios-heart
                    = link_to 'Unlike', like_path(:id => product.id), method: :delete

                .pull-right.text-right
                  i.icon.ion-ios-cart
                  = link_to 'Add to cart', cart_add_product_path(:product_id => product.id), method: :post
              h4.price.text-center= humanized_money_with_symbol product.price.exchange_to(@cart.currency)
              h4.text-center
                = link_to product.name, shop_path(product)
              .action-row.text-center.bottom.hover-content
                i.icon.ion-wand
                |Customise
= paginate @products