- content_for :title
  = @product.name.camelize

.row.product
  .col-md-6.text-center
    .product-images
      a href="#{@product.image_url}"
        = image_tag @product.image_url(:medium), :id => "zoom_03", 'data-zoom-image' => @product.image_url(:big)
      div#gallery_01
        - @product.product_images.each do |image|
          a href="#{image.image_url}" data-image=image.image_url(:medium) data-zoom-image=image.image_url(:big)
            = image_tag image.image_url(:thumbnail)

  .col-md-4.product-details
    h2.page-title.product-name= @product.name.camelize
    h4.price
      span= humanized_money_with_symbol @product.price.exchange_to(@cart.currency)

    = form_tag cart_add_product_path
      = hidden_field_tag :product_id, @product.id
      .add-to-cart-block.row
        .col-md-12.size-wrap
          .form-group
            /label.inline Size
            /- @standard_sizes.each do |s|
              /label.radio-inline#size
                /= radio_button_tag :standard_size_id, s.id
                /= s.name
            .input-append.select-size.select-width
              = select_tag "standard_size_id", options_from_collection_for_select(@standard_sizes, "id", "name"), class: ' form-control', prompt: 'Size'
            .size-guide
              a SIZE GUIDE
          #dis
      div.horizental-line-or.text-center.col-md-12.shop_selection_size
        span or
        div.horizental-line
      div.customize-size-wrap.col-md-12.shop_selection_size
        .col-md-12.no-padding
          h4 CUSTOMIZE 
          span.measure-link
            a HOW TO MEASURE
        .col-md-12.no-padding.customize-size-inner-wrap
          p Edit from pre-defined or enter your own (in inches)

          .row
            .col-md-4
              label BUST/CHEST 
              div.input-append
                input.form-control type='text' id='bust_chest' name='bust_chest'
                input.inches type='text' readonly='readonly' value='in'

            .col-md-4
              label WAIST 
              div.input-append
                input.form-control type='text' id='waist' name='waist'
                input.inches type='text' readonly='readonly' value='in'
            .col-md-4
              label WAIST TO ANKLE
              div.input-append
                input.form-control type='text' id='waist_to_ankle' name='waist_to_ankle'
                input.inches type='text' readonly='readonly' value='in'
            .col-md-4
              label HIPS
              div.input-append
                input.form-control type='text' id='hips' name='hips'
                input.inches type='text' readonly='readonly' value='in'
            .col-md-4
              label SHOULDER
              div.input-append
                input.form-control type='text' id='shoulder' name='shoulder'
                input.inches type='text' readonly='readonly' value='in'
            .col-md-4
              label SHOULDER TO NECK
              div.input-append
                input.form-control type='text' id='shoulder_to_neck' name='shoulder_to_neck'
                input.inches type='text' readonly='readonly' value='in'
            .col-md-4.clearboth
              label AROUND ARMPIT 
              div.input-append
                input.form-control type='text' id='around_armpit' name='around_armpit'
                input.inches type='text' readonly='readonly' value='in'
            .col-md-4
              label AROUND NECK
              div.input-append
                input.form-control type='text' id='around_neck' name='around_neck'
                input.inches type='text' readonly='readonly' value='in'
            .col-md-4
              label SLEEVE LENGTH
              div.input-append
                input.form-control type='text' id='sleev_length' name='sleev_length'
                input.inches type='text' readonly='readonly' value='in' 
      - if @product.description?
        .product-desc-wrap.col-md-12
          h4 PRODUCT DESCRIPTION
          .description
            == @product.description
      /.form-inline
            /.form-group
              /label.inline for="quantity" Quantity
              /input#quantity.form-control name="quantity" type="number" min="1" value="1"
      /.checkbox
            /label for="gift"
              /input#gift name="is_gift" type="checkbox" value="1"
              /|Gift
      /.form-group
            /.send-gift-to.hidden
              /label for="message" Message
              /input#message.form-control name="message" type="text"          
      .actions.text-center
        button.info-row.text-uppercase.active.add-to-cart-size type="submit" 
          i.icon.ion-ios-cart
          span Add to cart
        - if !current_or_null_user.liked?(@product)
          .info-row.text-uppercase
            a href="#{likes_path(id: @product.id)}" data-method="post"
              i.icon.ion-ios-heart-outline
              span Add to favorite
        - else
          .info-row.text-uppercase
            a href="#{like_path(id: @product.id)}" data-method="delete"
              i.icon.ion-ios-heart
              span Remove from favorites

                /.col-md-12
    /.product-tabs
      /div#produc-desc-tabs
        /! Nav tabs
        /ul.nav.nav-tabs role="tablist" 
          /li.active
            /a aria-controls="descpts" data-toggle="tab" href="#descpts" role="tab"
              /|Product Info
          /li
          /  a aria-controls="material" data-toggle="tab" href="#material" role="tab"
          /    |Materials
          /li
          /  a aria-controls="reviews" data-toggle="tab" href="#reviews" role="tab"
          /    |Reviews


        /! Tab panes
        /.tab-content.product-content-tabs
          /#descpts.tab-pane.active role="tabpanel"  
            /== @product.description
            /== @product.material

          /#material.tab-pane role="tabpanel"
          /  == @product.material

          /#reviews.tab-pane role="tabpanel"
            /.review-wrap
              /h4 REVIEWS
              /.top-review-list
                /- @reviews.each do |r|
                  /.media
                    /.media-left
                      /a href="#"
                        /= user_avatar r.user
                    /.media-body
                      /.comment-writer-info
                        /strong
                          /= r.user.name
                          /br
                        /span= time_ago_in_words r.created_at

                        /| &nbsp; ago
                      /p== simple_format r.message

            /- if user_signed_in?
              /.write-reviews
                /h4 WRITE A REVIEW
                /= simple_form_for @review, url: shop_reviews_path(@product.id), wrapper: :horizontal_small_form do |p|
                  /.form-inputs.row
                    /.col-md-6.review-box
                      /= p.input :message, class: 'review-message'
                      /label#rev-msg
                    /.col-md-6
                      /= p.button :submit,"SUBMIT REVIEW", class: 'review-button'

            /- else
              /|Login to Review this product

