- content_for :title do
  | Cart 
.row.product-wrap
  .col-md-8
    
      h4 My Cart
      .product-block-wrap

        .product-block
          .product-img-block
            a href="javascript:void(0)"
              =image_tag "avatar.png" ,class: 'img-responsive'
          .product-info-block
            .col-md-12.product-inner-block
              .col-md-9.no-left-padding
                .col-md-12.no-paddin
                  h5.product-name
                    a href="" 
                      |dress title
                  .product-other-details.cleasfix
                    span.choosen-size
                      label Size
                      .input-append
                        select
                          option M
                    span.choosen-qty
                      label qty
                      .input-append
                        input type="number" step='1' value="1"        
                  .add-remove
                    ul 
                      li
                        a Remove
                      li.line |
                      li
                        a Move to wishlist

              .col-md-3.no-right-padding.text-right
                .actual-price
                  span &#x20B9;
                  |1799
                .after-discount
                  span &#x20B9;
                  |1799

        .product-block
          .product-img-block
            a href="javascript:void(0)"
              =image_tag "avatar.png" ,class: 'img-responsive'
          .product-info-block
            .col-md-12.product-inner-block
              .col-md-9.no-left-padding
                .col-md-12.no-paddin
                  h5.product-name
                    a href="" 
                      |dress title
                  .product-other-details.cleasfix
                    span.choosen-size
                      label Size
                      .input-append
                        select
                          option M
                    span.choosen-qty
                      label qty
                      .input-append
                        input type="number" step='1' value="1"        
                  .add-remove
                    ul 
                      li
                        a Remove
                      li.line |
                      li
                        a Move to wishlist

              .col-md-3.no-right-padding.text-right
                .actual-price
                  span &#x20B9;
                  |1799
                .after-discount
                  span &#x20B9;
                  |1799


  .col-md-3.pull-right
    h4 Order Summary
    .amount-calculation
      p
        | SUB TOTAL:
        span
          span.indian-rupee &#x20B9
          | 1234
      p
        | DISCUNT:
        span
          span.indian-rupee &#x20B9
          | 1234

      p
        | DISCOUNT CODE:
        span
          span.indian-rupee &#x20B9
          | 1234
      p
        | VAT*:
        span
          span.indian-rupee &#x20B9
          | 1234
      #total-amount.total-amount
        | TOTAL PAYABLE AMOUNT:
        span
          span.indian-rupee> ₹
          | 1299
    = link_to 'checkout', :shop_index, class: 'btn btn-primary continue-shop'
    = link_to 'Continue Shopping', :shop_index, class: 'btn btn-primary continue-shop'


.row
  .col-sm-8
    .col-sm-12.no-right-padding.update-wrap
      input.pull-right.btn.btn-default[type="submit" name="update_cart" value="Update Cart" onclick="this.disabled = true;this.form.submit();"]
    = form_tag cart_discount_path, method: 'patch', class: 'form-inline' do
      .coupon
        input#coupon_code.form-control[type="text" name="coupon_code" placeholder="Discount or Gift code"]
        input#validateForm.apply-coupon.btn.btn-primary[type="submit" name="apply_coupon" value="Apply Coupon"]
        #coupon_code_err_message
