- content_for :title do
  = "Order ##{@order.id}"

.row
  .col-md-4.col-lg-3= render 'accounts/sidebar'
  .col-md-8.col-lg-9
    .row
      h4.col-xs-8.text-uppercase Order No. #{@order.id}
      h4.col-xs-4.text-right= humanized_money_with_symbol @order.total
    .row
      p.col-sm-8 Placed on #{@order.created_at.strftime '%A, %B %d, %Y'} / #{pluralize(@order.product_items.count, 'item')}
      - if @order.shipments.present?
        p.col-sm-4= link_to 'Track Shipping', @order.shipments.first.tracking_link, target: '_blank'

    - @order.product_items.each_with_index do |p, i|
      h4.divided
        span Item ##{i+1}
      .row
        .col-sm-3
        h4.col-xs-7= p.title
        h4.col-xs-2.text-right= humanized_money_with_symbol p.subtotal