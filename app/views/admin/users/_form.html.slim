= simple_form_for([:admin, @user]) do |f|
  = f.error_notification

  .form-inputs.row
    .col-sm-6
      = f.input :name
      = f.input :email
      = f.input :password
      = f.input :password_confirmation
    .col-sm-6
      = f.association :roles, collection: Role.all, as: :check_boxes
      = f.button :submit
