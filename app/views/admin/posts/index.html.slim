- content_for :heading do
  | Listing Posts 
- content_for :title do
  | Posts 
- content_for :panel_heading do
  = link_to 'Add Post', new_admin_post_path, class: 'btn btn-success btn-sm'

table.table.table-responsive.table-striped
  thead
    tr
      th Image
      th Title
      th Created At
      th[colspan="3"] Action
  tbody
    - @posts.each do |post|
      tr
        td= image_tag post.image_url(:thumbnail)
        td= post.title
        td= post.created_at
        td= link_to 'Show', trend_path(post)
        td= link_to 'Edit', edit_admin_post_path(post)
        td= link_to 'Destroy', admin_post_path(post), method: :delete, data: {confirm: 'Are you sure?'}
= paginate @posts
