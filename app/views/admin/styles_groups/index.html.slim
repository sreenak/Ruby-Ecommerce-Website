- content_for :heading do
  | Listing Styles
- content_for :title do
  | Styles
- content_for :panel_heading do
  = link_to 'Add Style Group', new_admin_dress_styles_group_path(@dress), class: 'btn btn-success btn-sm'

table.table.table-responsive.table-striped
  thead
    tr
      th Name
      th[colspan="2"] Action
  tbody
    - @styles_groups.each do |styles_group|
      tr
        td= styles_group.name
        td= link_to 'Edit', edit_admin_dress_styles_group_path(styles_group.dress, styles_group)
        td= link_to 'Destroy', admin_dress_styles_group_path(styles_group.dress, styles_group), method: :delete, data: {confirm: 'Are you sure?'}
= paginate @styles_groups

