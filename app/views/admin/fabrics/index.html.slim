- content_for :heading do
  | Listing Fabrics
- content_for :title do
  | Fabrics
- content_for :panel_heading do
  = link_to 'Add Fabric', new_admin_fabric_path, class: 'btn btn-success btn-sm'

table.table.table-responsive.table-striped
  thead
    tr
      th Name
      th Colors
      th[colspan="2"] Action
  tbody
    - @fabrics.each do |fabric|
      tr
        td= fabric.name
        td= fabric.fabric_colors.map(&:name).join(', ')
        td= link_to 'Edit', edit_admin_fabric_path(fabric)
        td= link_to 'Destroy', admin_fabric_path(fabric), method: :delete, data: {confirm: 'Are you sure?'}
= paginate @fabrics
