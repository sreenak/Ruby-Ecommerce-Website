- content_for :heading do
  | Listing Pages 
- content_for :title do
  | Pages 
- content_for :panel_heading do
    = link_to 'Add Page', new_admin_page_path, class: 'btn btn-success btn-sm'

table.table.table-responsive.table-striped
  thead
    tr
      th
        | Title
      th[colspan="3"]
        | Action
  tbody
    - @pages.each do |page|
      tr
        td
          = page.title
        td
          = link_to 'Show', page_path(page)
        td
          = link_to 'Edit', edit_admin_page_path(page)
        td
          = link_to 'Destroy', admin_page_path(page), method: :delete, data: {confirm: 'Are you sure?'}
= paginate @pages
