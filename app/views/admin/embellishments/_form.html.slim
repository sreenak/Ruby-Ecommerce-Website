= simple_form_for [:admin, @embellishment], wrapper: :horizontal_small_form do |p|
  .form-inputs.row
    .col-md-6
      = p.input :name
      = image_tag @embellishment.image_url(:thumbnail) if @embellishment.image?
      = p.input :image
      = p.hidden_field :image_cache
    .col-md-6
      = p.button :submit
