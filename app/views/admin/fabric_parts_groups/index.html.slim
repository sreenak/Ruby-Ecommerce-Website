- content_for :heading do
  | Listing Dresses
- content_for :title do
  | Dresses
- content_for :panel_heading do
  = link_to 'Add Fabric Group', new_admin_dress_fabric_parts_group_path(@dress), class: 'btn btn-success btn-sm'

table.table.table-responsive.table-striped
  thead
    tr
      th Name
      th[colspan="2"] Action
  tbody
    - @fabric_parts_groups.each do |fabric_parts_group|
      tr
        td= fabric_parts_group.name
        td= link_to 'Edit', edit_admin_dress_fabric_parts_group_path(fabric_parts_group.dress, fabric_parts_group)
        td= link_to 'Destroy', admin_dress_fabric_parts_group_path(fabric_parts_group.dress, fabric_parts_group), method: :delete, data: {confirm: 'Are you sure?'}
= paginate @fabric_parts_groups

