<table class="table">
  <tbody> 
	  <thead>
	  <tr>
	    <td>Name</td>
	    <td>Item Name</td>
	    <td>Quantity</td>
	    <td>Price</td>
	  </tr>
	  </thead> 
	  <% @order.line_items.each do |item| %>
	      <tr>
	      	<td><%= @order.user.name %></td>
	        <td><%= item.line_itemable_type %></td>
	        <td><%= item.quantity %></td>
	        <td><%= humanized_money_with_symbol item.price_paisas %></td>
	        <!--<td><%#= link_to 'Edit', edit_admin_order_path(@order) %></td>-->
            <td><%= link_to 'Back', admin_orders_path %></td>
	      </tr>
	  <% end %>
</tbody>
</table>
