<% content_for :heading do %>Listing Orders<% end %>
<% content_for :title do %>Listing Orders<% end %>

<div class="panel panel-default">
  <div class="panel-heading"><!--%= link_to 'Add Order', new_admin_order_path, class: 'btn btn-success btn-sm' %--></div>
  <div class="panel-body">
    <table class="table no-margn table striped">
      <thead>
      <tr>
        <th>#</th>
        <th>Customer</th>
        <th>Total</th>
        <th>Status</th>
        <th colspan="3">Actions</th>
      </tr>
      </thead>
      <tbody>
      <% @orders.each do |order| %>
          <tr>
            <td><%= order.id %></td>
            <td><%= link_to order.user.name, admin_user_path(order.user.id) %></td>
            <td><%= humanized_money_with_symbol order.total_paisas %></td>
            <td><%= order.status %></td>
            <td><%= link_to 'Shiping Status', admin_order_shippings_path(order) %></td>
            <td><%= link_to 'Show', admin_order_path(order) %></td>
            <td><%= link_to 'Edit', edit_admin_order_path(order) %></td>
            <td><%= link_to 'Destroy', admin_order_path(order), method: :delete, data: {confirm: 'Are you sure?'} %></td>
          </tr>
      <% end %>
      </tbody>
    </table>
  </div>
</div>
