- content_for :heading do
  | Listing orders
- content_for :title do
  | Orders
- content_for :panel_heading do
    = link_to 'Add Order', new_admin_order_path, class: 'btn btn-success btn-sm'

table.table.table-responsive.table-striped
  thead
    tr
      th
        | ID
      th
        | Customer
      th
        | Total
      th
        | Status
      th[colspan="3"]
        | Action
  tbody
    - @orders.each do |order|
      tr
        td
          = order.id
        td
          = link_to 'Show', page_path(page)
        td
          = link_to 'Edit', edit_admin_page_path(page)
        td
          = link_to 'Destroy', admin_page_path(page), method: :delete, data: {confirm: 'Are you sure?'}
= paginate @pages
