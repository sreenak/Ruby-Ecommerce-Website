- content_for :heading do
  | Listing Products
- content_for :title do
  | Products
- content_for :panel_heading do
  = link_to 'Add Product', new_admin_product_path, class: 'btn btn-success btn-sm'

table.table.table-responsive.table-striped
  thead
    tr
      th ID
      th Image
      th Name
      th Price
      th[colspan="3"] Action
  tbody
    - @products.each do |product|
      tr
        td= product.id
        td= image_tag product.image_url(:thumbnail)
        td= product.name
        td= humanized_money_with_symbol product.price
        td= link_to 'Show', shop_path(product)
        td= link_to 'Edit', edit_admin_product_path(product)
        td= link_to 'Destroy', admin_product_path(product), method: :delete, data: {confirm: 'Are you sure?'}
= paginate @products

