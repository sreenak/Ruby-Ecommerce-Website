
<div class="container search-show">
	<p class="seach-result-count">You searched for ‘<span>trends</span>’. Showing 7 results.</p>
	<div class="seach-list">
		
		<br><br><br>
		<div class="col-lg-4 col-md-4 col-sm-6 col-xs-12 text-center mb30 selected_mouse_over mobile-no-padding">

<% @products.each do |product| %>

      <div class="col-md-4 col-sm-6 text-center mb30 selected_mouse_over mobile-no-padding">
        <a href="<%= shop_path product %>">
          <br/><br/><br/>

          <div class="cart-img">
            <%= image_tag product.image_url(:medium) %>
            <!-- Mobile Cart -->
            <div class="mobile-cart visible-xs">
              <div class="cart-btn-block">
                <div class="col-xs-5 left-no-padding m-add-to-cart">
                  <span class="addto-to-cart-img"></span>
                  <span class="">ADD TO CART</span>
                </div>

                <div class="col-xs-2 m-fav text-center">
                  <span class="fav_icon"> </span>
                </div>

                <div class="col-xs-5 m-customize">
                  <span class="item_customise_icon"></span>
                  <span class="item_customise_text">customise</span>
                </div>

                <div class="clearfix"></div>
              </div>

              <div class="cart-details">
                <div class="cart-title"> <%= product.name %></div>
                <span><b><%= humanized_money_with_symbol product.price.exchange_to(@cart.currency) %> </b></span>
              </div>

            </div>
            <!-- mouse over functionality starts here-->
            <div class="cart-hover hidden-xs">
              <div class="add-to-cart">
                <div class="add-to-cart-btn">
                  <div class="add_to_cart">
                    <span class="addto-to-cart-img"></span>
                    
                  </div>
                  <div class="add-to-fav">
                   
                  </div>
                </div>
              </div>
              <!--<div class="cart-hover-customize">-->
              <!--&lt;!&ndash; <a href="#">&#xf040; CUSTOMISE </a> &ndash;&gt;-->
              <!--<span class="item_customise_icon"></span>-->
              <!--<span class="item_customise_text">customise</span>-->
              <!--</div>-->
            </div>
            <!-- mouse over functionality starts here-->

          </div>
          <div class="cart-title hidden-xs"> <%= product.name %></div>
          <div class="cart-cost hidden-xs">
            <b><%= humanized_money_with_symbol product.price.exchange_to(@cart.currency) %></b></div>
        </a>
      </div>
  <% end %>
	</div>
		</div>
