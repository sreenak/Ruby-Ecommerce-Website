.container.search-show
  p.seach-result-count
    | You searched for ‘
    span
      | trends
    | ’. Showing 7 results.
  .seach-list
    br
    br
    br
    .col-lg-4.col-md-4.col-sm-6.col-xs-12.text-center.mb30.selected_mouse_over.mobile-no-padding
      |  <% @products.each do |product| %> 
      .col-md-4.col-sm-6.text-center.mb30.selected_mouse_over.mobile-no-padding
        a[href="<%= shop_path product %>"]
          br
          br
          br
        .cart-img
          |  <%= image_tag product.image_url(:medium) %> 
          .mobile-cart.visible-xs
            .cart-btn-block
              .col-xs-5.left-no-padding.m-add-to-cart
                span.addto-to-cart-img
                span
                  | ADD TO CART
              .col-xs-2.m-fav.text-center
                span.fav_icon

              .col-xs-5.m-customize
                span.item_customise_icon
                span.item_customise_text
                  | customise
              .clearfix
            .cart-details
              .cart-title
                |  <%= product.name %>
              span
                b
                  | <%= humanized_money_with_symbol product.price.exchange_to(@cart.currency) %> 
          .cart-hover.hidden-xs
            .add-to-cart
              .add-to-cart-btn
                .add_to_cart
                  span.addto-to-cart-img
                .add-to-fav

        .cart-title.hidden-xs
          |  <%= product.name %>
        .cart-cost.hidden-xs
          b
            | <%= humanized_money_with_symbol product.price.exchange_to(@cart.currency) %>
      |  <% end %> 
  .clearfix
