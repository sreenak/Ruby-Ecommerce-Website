- content_for :title do
  |Search Results
.col-md-9.product-search
  .search-show
    p.seach-result-count
      | You searched for ‘
      em
        = @key
      |’.&nbsp;
      - if @products.present?
        |Showing&nbsp;
        = pluralize @products.count, ' result'
  .products
    - if @products
      - if @products.empty?
        h2 No products found.
      - else
        - @products.each_slice(3) do |row|
          .row.home-product
            - row.each do |product|
              .col-md-4.col-sm-4
                .product-preview.hover-container
                  a href="#{shop_path(product)}"
                    = image_tag product.image_url(:medium)
                  .details
                    h4.text-center
                      = link_to truncate(product.name.camelize, :length => 20), shop_path(product)
                    h4.price.text-center
                      -if @cart.currency=="USD"
                        = '$'+ (product.price.exchange_to(@cart.currency).to_i+1).to_s
                      -else @cart.currency=="INR"
                        = '₹'+ (product.price.exchange_to(@cart.currency).to_i).to_s  
                    action-row.top.clearfix.hover-content
                      .pull-right.col-md-6.product-wishliat.text-center
                        - if !current_or_null_user.liked? product
                          -if !user_signed_in?
                            a.text-center href="#" rel="nofollow" data-toggle="modal" data-target="#login-modal"
                              i.icon.ion-ios-heart-outline
                              |Like
                          -else
                            a.text-center href="#{likes_path(:id => product.id)}" data-method="post" rel="nofollow"
                              i.icon.ion-ios-heart-outline
                              |Like
                        - else
                          a.text-center href="#{like_path(:id => product.id)}" data-method="delete" rel="nofollow"
                            i.icon.ion-ios-heart
                            |Unlike

                      .pull-left.text-center.col-md-6.product-addto
                        a.text-center href="#{cart_add_product_path(:product_id => product.id)}" data-method="post" rel="nofollow"
                          i.icon.ion-ios-cart
                          |Add to cart
  = paginate @products

  .blog-result
    - if @trends.present?
      h4 BLOG RESULTS
    .blog-list
      - @trends.each do |t|
        h4= t.title
        p= truncate(strip_tags(t.body), length: 250)
    = paginate @trends